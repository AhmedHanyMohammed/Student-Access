<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventPass Admin Portal</title>
    <!-- Modern Bootstrap 5 & Google Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --brand-primary: #6C63FF;
            --brand-primary-hover: #5A52E0;
            --brand-bg: #F8F9FC;
            --brand-sidebar: #1E1B4B;
            --brand-sidebar-hover: #2E2A72;
            --brand-card-border: #E2E8F0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--brand-bg);
            color: #1E293B;
            min-height: 100vh;
        }

        .portal-sidebar {
            width: 260px;
            background-color: var(--brand-sidebar);
            min-height: 100vh;
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
        }

        .portal-sidebar .nav-link {
            color: #C7D2FE;
            font-weight: 600;
            font-size: 0.92rem;
            padding: 0.75rem 1.25rem;
            border-radius: 12px;
            margin: 0.2rem 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.2s ease;
        }

        .portal-sidebar .nav-link:hover, .portal-sidebar .nav-link.active {
            background-color: var(--brand-primary);
            color: #FFFFFF;
        }

        .portal-content {
            margin-left: 260px;
            padding: 2rem;
            min-height: 100vh;
        }

        .card-custom {
            border: 1px solid var(--brand-card-border);
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
            background-color: #FFFFFF;
        }

        .btn-brand {
            background-color: var(--brand-primary);
            color: white;
            font-weight: 600;
            border-radius: 12px;
            padding: 0.55rem 1.25rem;
            border: none;
        }

        .btn-brand:hover {
            background-color: var(--brand-primary-hover);
            color: white;
        }

        .badge-cat {
            font-weight: 700;
            font-size: 0.78rem;
            padding: 0.35rem 0.7rem;
            border-radius: 20px;
        }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="portal-sidebar p-3 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 px-2 py-3 mb-4 border-bottom border-light border-opacity-10">
                <span class="fs-3">🎟️</span>
                <div>
                    <h5 class="m-0 fw-bold text-white">EventPass</h5>
                    <small class="text-white-50" style="font-size: 0.75rem;">Admin Management Portal</small>
                </div>
            </div>

            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="/Portal/Dashboard" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2 fs-5"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a href="/Portal/Events" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Events" ? "active" : "")">
                        <i class="bi bi-calendar-event fs-5"></i> Events & Passes
                    </a>
                </li>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <li>
                        <a href="/Portal/Admins" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Admins" ? "active" : "")">
                            <i class="bi bi-shield-lock fs-5"></i> Admin Accounts
                        </a>
                    </li>
                    <li>
                        <a href="/Portal/Categories" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "active" : "")">
                            <i class="bi bi-tags fs-5"></i> Categories
                        </a>
                    </li>
                }
            </ul>

            <div class="mt-auto border-top border-light border-opacity-10 pt-3 px-2">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="rounded-circle bg-primary bg-opacity-25 p-2 text-center" style="width: 38px; height: 38px;">
                        👤
                    </div>
                    <div class="overflow-hidden">
                        <div class="fw-bold text-white text-truncate" style="font-size: 0.88rem;">@User.Identity?.Name</div>
                        <span class="badge @(User.IsInRole("SuperAdmin") ? "bg-warning text-dark" : "bg-info")" style="font-size: 0.7rem;">
                            @(User.IsInRole("SuperAdmin") ? "SuperAdmin" : "Category Admin")
                        </span>
                    </div>
                </div>
                <a href="/Portal/Logout" class="btn btn-outline-danger btn-sm w-100 rounded-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </a>
            </div>
        </div>

        <div class="portal-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    }
    else
    {
        <div class="container py-5">
            @RenderBody()
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
