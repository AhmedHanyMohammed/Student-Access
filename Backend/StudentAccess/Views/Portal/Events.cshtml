@model List<EventPassApi.Models.Event>
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Events Management";
    var categories = ViewBag.Categories as List<EventPassApi.Models.Category> ?? new();
    var selectedCatId = ViewBag.SelectedCategoryId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0">Campus Events</h3>
        <p class="text-muted small m-0">
            @if (User.IsInRole("SuperAdmin"))
            {
                <span>Full System Access • All Event Categories</span>
            }
            else
            {
                <span>Scoped to category: <strong>@User.FindFirst("CategoryName")?.Value</strong></span>
            }
        </p>
    </div>
    <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#createEventModal">
        <i class="bi bi-calendar-plus-fill me-1"></i> Add Event
    </button>
</div>

<!-- Category Filter Pills (For SuperAdmin) -->
@if (User.IsInRole("SuperAdmin"))
{
    <div class="d-flex gap-2 overflow-auto pb-3 mb-3">
        <a href="/Portal/Events" class="btn btn-sm @(selectedCatId == null ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3">
            All Categories
        </a>
        @foreach (var cat in categories)
        {
            <a href="/Portal/Events?categoryId=@cat.Id" class="btn btn-sm @(selectedCatId == cat.Id ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
                @cat.Name
            </a>
        }
    </div>
}

<div class="card card-custom p-4">
    @if (Model.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-calendar2-x fs-1 d-block mb-2 text-secondary"></i>
            No events found in this view.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light small">
                    <tr>
                        <th>Event Title</th>
                        <th>Category</th>
                        <th>Date & Time</th>
                        <th>Location</th>
                        <th>Registrations</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td class="fw-bold">@ev.Title</td>
                            <td>
                                <span class="badge badge-cat" style="background-color: @(ev.Category?.ColorHex ?? "#6C63FF")15; color: @(ev.Category?.ColorHex ?? "#6C63FF"); border: 1px solid @(ev.Category?.ColorHex ?? "#6C63FF")40;">
                                    @(ev.Category?.Name ?? "General")
                                </span>
                            </td>
                            <td>
                                <div><i class="bi bi-calendar3 me-1 text-muted"></i>@ev.EventDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@ev.EventDate.ToLocalTime().ToString("hh:mm tt")</small>
                            </td>
                            <td class="small text-muted">@ev.Location</td>
                            <td>
                                <a href="/Portal/EventAttendees/@ev.Id" class="badge bg-secondary rounded-pill text-decoration-none">
                                    <i class="bi bi-people-fill me-1"></i> @ev.Registrations.Count Students
                                </a>
                            </td>
                            <td>
                                @if (ev.EventDate < DateTime.UtcNow)
                                {
                                    <span class="badge bg-light text-muted border">Past</span>
                                }
                                else if (ev.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/Portal/EventAttendees/@ev.Id" class="btn btn-sm btn-outline-primary rounded-3 me-1" title="View Registered Students">
                                    <i class="bi bi-people"></i>
                                </a>
                                <form method="post" action="/Portal/DeleteEvent" class="d-inline" onsubmit="return confirm('Delete event @ev.Title?');">
                                    <input type="hidden" name="id" value="@ev.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Delete Event">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal: Create Event -->
<div class="modal fade" id="createEventModal" tabindex="-1" aria-labelledby="createEventModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createEventModalLabel">Schedule New Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Portal/CreateEvent">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Event Title</label>
                        <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Campus Music Fest 2026" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Description (Optional)</label>
                        <textarea name="description" class="form-control rounded-3" rows="3" placeholder="Details about this campus event..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Date & Time</label>
                        <input type="datetime-local" name="eventDate" class="form-control rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Location / Venue</label>
                        <input type="text" name="location" class="form-control rounded-3" placeholder="e.g. Auditorium Hall B" required />
                    </div>

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Category</label>
                            <select name="categoryId" class="form-select rounded-3" required>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2 px-3 small rounded-3">
                            <i class="bi bi-info-circle me-1"></i> This event will be automatically assigned to your department category: <strong>@User.FindFirst("CategoryName")?.Value</strong>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-brand">Publish Event</button>
                </div>
            </form>
        </div>
    </div>
</div>
